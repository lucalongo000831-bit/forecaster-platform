{
  "name": "kairo-market-intelligence",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:providers": "node scripts/test-financial-providers.mjs",
    "test:live-providers": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/test-live-providers.ts",
    "test:new-providers": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/test-new-data-providers.ts",
    "test:complete-data-stack": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/test-complete-data-stack.ts",
    "test:political": "node --env-file-if-exists=.env.local scripts/test-political-intelligence.mjs",
    "political:backfill": "node --env-file-if-exists=.env.local scripts/political-backfill.mjs",
    "political:v3:backfill": "node --conditions=react-server --env-file-if-exists=.env.local --import=tsx scripts/political-v3-backfill.ts",
    "test:political:v3:sources": "node --conditions=react-server --env-file-if-exists=.env.local --import=tsx scripts/test-political-v3-sources.ts",
    "test:company-smoke": "node scripts/test-company-intelligence.mjs",
    "test:stlam": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/test-stlam-complete-coverage.ts",
    "test:kairo-data-v2": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/test-kairo-data-v2-providers.ts",
    "test:kairo-data-v2:security": "node --env-file-if-exists=.env.local scripts/verify-kairo-data-v2-security.mjs",
    "data-v2:diagnose": "node scripts/diagnose-kairo-data-v2.mjs",
    "data-v2:backfill": "node --env-file-if-exists=.env.local scripts/backfill-kairo-data-v2.mjs",
    "issuer:backfill": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/issuer-backfill.ts",
    "test:openai": "node --env-file-if-exists=.env.local scripts/verify-openai.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "openai": "^7.4.0",
    "parse5": "^8.0.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "yahoo-finance2": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
